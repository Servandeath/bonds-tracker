<div id="<%= dom_id bond %>">
  <div>
    <strong>Isin:</strong>
    <%= bond.isin %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= bond.name %>
  </div>

  <div>
    <strong>Issuer:</strong>
    <%= bond.issuer %>
  </div>

  <div>
    <strong>Coupon rate:</strong>
    <%= bond.coupon_rate %>
  </div>

  <div>
    <strong>Face value:</strong>
    <%= bond.face_value %>
  </div>

  <div>
    <strong>Maturity date:</strong>
    <%= bond.maturity_date %>
  </div>

  <div>
    <strong>Currency:</strong>
    <%= bond.currency %>
  </div>

</div>
