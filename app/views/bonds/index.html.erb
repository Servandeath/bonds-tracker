<!DOCTYPE html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<div class="container-fluid py-3">
  <h1 class="mb-3">Облигации</h1>
  <div class="mb-2">
  <small class="text-muted me-2">Колонки:</small>
  <% ["ISIN", "Название", "Эмитент", "Купон %", "Номинал", "Погашение", "Валюта"].each_with_index do |col, i| %>
    <div class="form-check form-check-inline">
      <input class="form-check-input col-toggle" type="checkbox" id="col_<%= i %>" data-col="<%= i %>" checked>
      <label class="form-check-label" for="col_<%= i %>"><%= col %></label>
    </div>
  <% end %>
</div>

  <%= search_form_for @q, url: bonds_path, method: :get, html: {class: "row g-2 mb-3"} do |f| %>
    <div class="col-md-3">
      <%= f.search_field :name_cont, placeholder: "Название", class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= f.number_field :coupon_rate_gteq, placeholder: "Купон от %", class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= f.number_field :coupon_rate_lteq, placeholder: "Купон до %", class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= f.date_field :maturity_date_gteq, placeholder: "Погашение от", class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= f.select :currency_eq, [["Любая", ""], ["RUB/SUR", "SUR"], ["CNY", "CNY"]], {}, class: "form-select" %>
    </div>
    <div class="col-md-1">
      <%= f.submit "Найти", class: "btn btn-primary w-100" %>
    </div>
  <% end %>

  <div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">Найдено: <%= @bonds.total_count %></span>
    <div>
      Показывать:
      <% [50, 100, 250, 500].each do |n| %>
        <%= link_to n, bonds_path(q: params[:q]&.to_unsafe_h, per_page: n), class: "btn btn-sm #{ params[:per_page].to_i == n ? 'btn-primary' : 'btn-outline-secondary' } ms-1" %>
      <% end %>
    </div>
  </div>

  <table class="table table-striped table-hover table-sm">
    <thead class="table-dark">
      <tr>
        <th><%= sort_link @q, :isin, "ISIN" %></th>
        <th><%= sort_link @q, :name, "Название" %></th>
        <th><%= sort_link @q, :issuer, "Эмитент" %></th>
        <th><%= sort_link @q, :coupon_rate, "Купон %" %></th>
        <th><%= sort_link @q, :face_value, "Номинал" %></th>
        <th><%= sort_link @q, :maturity_date, "Погашение" %></th>
        <th>Валюта</th>
      </tr>
    </thead>
    <tbody>
      <% @bonds.each do |bond| %>
        <tr>
          <td><%= bond.isin %></td>
          <td><%= bond.name %></td>
          <td><%= bond.issuer %></td>
          <td><%= bond.coupon_rate || "—" %></td>
          <td><%= bond.face_value %></td>
          <td><%= bond.maturity_date %></td>
          <td><%= bond.currency %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @bonds %>
  <script>
  const toggles = document.querySelectorAll('.col-toggle');
  const saved = JSON.parse(localStorage.getItem('bondCols') || '{}');

  toggles.forEach(cb => {
    const col = cb.dataset.col;
    if (saved[col] === false) { cb.checked = false; toggleCol(col, false); }
    cb.addEventListener('change', () => {
      toggleCol(col, cb.checked);
      saved[col] = cb.checked;
      localStorage.setItem('bondCols', JSON.stringify(saved));
    });
  });

  function toggleCol(col, show) {
    document.querySelectorAll(`tr td:nth-child(${+col+1}), tr th:nth-child(${+col+1})`)
      .forEach(el => el.style.display = show ? '' : 'none');
  }
</script>
</div>